APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://iiot:iiot@postgres:5432/iiot
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=factory/+/telemetry
OPCUA_URL=opc.tcp://opcua-server:4840/factory/server/
OPCUA_BIND_URL=opc.tcp://0.0.0.0:4840/factory/server/
MODEL_PATH=/app/artifacts/isolation_forest.joblib
MODEL_METADATA_PATH=/app/artifacts/model_metadata.json
ANOMALY_THRESHOLD=-0.02
API_BASE_URL=http://api:8000
SIMULATION_INTERVAL_SECONDS=1.0
